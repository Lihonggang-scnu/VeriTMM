{
  "schema_version": "tolerance-task-v1",
  "mode": "tolerance",
  "tolerance": {
    "simulation": {
      "stack": {
        "name": "single-film-tolerance",
        "incident": {"constant_n": 1.0},
        "exit": {"constant_n": 1.52},
        "layers": [
          {"constant_n": 1.38, "thickness_nm": 100.0, "optimizable": false}
        ]
      },
      "spectrum": {"start_nm": 500.0, "stop_nm": 650.0, "points": 101},
      "illumination": {"angles_deg": [0.0], "polarizations": ["unpolarized"]},
      "solver": "smatrix",
      "requested_outputs": ["R", "T", "A"]
    },
    "uncertainties": [
      {"layer_index": 0, "distribution": "normal", "sigma_nm": 2.0}
    ],
    "metric": {
      "name": "mean_T",
      "observable": "T",
      "wavelength_min_nm": 520.0,
      "wavelength_max_nm": 620.0,
      "aggregation": "mean"
    },
    "target": {
      "metric": {
        "name": "mean_T",
        "observable": "T",
        "wavelength_min_nm": 520.0,
        "wavelength_max_nm": 620.0,
        "aggregation": "mean"
      },
      "constraint": "at_least",
      "value": 0.97
    },
    "sample_count": 32,
    "seed": 42
  }
}
